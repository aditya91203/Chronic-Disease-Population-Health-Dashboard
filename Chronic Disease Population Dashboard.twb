              <calculation class='tableau' formula='IF [geo_name] = [Parameters].[Parameter 3] THEN &quot;Selected&quot; ELSE &quot;Other&quot; END' />
            </column>
            <column caption='YoY ER Change' datatype='real' name='[Calculation_659214405221548045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(AVG([er_visits_per_1000])) - LOOKUP(ZN(AVG([er_visits_per_1000])), -1))&#13;&#10;/ ABS(LOOKUP(ZN(AVG([er_visits_per_1000])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[geo_name]' derivation='Attribute' name='[attr:geo_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='Attribute' name='[attr:year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[er_visits_per_1000]' derivation='Avg' name='[avg:er_visits_per_1000:qk]' pivot='key' type='quantitative' />
            <column-instance column='[inpatient_stays_per_1000]' derivation='Avg' name='[avg:inpatient_stays_per_1000:qk]' pivot='key' type='quantitative' />
