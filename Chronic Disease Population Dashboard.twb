      <column caption='Selected Condition Prevalence' datatype='real' name='[Calculation_659214405122940928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;  WHEN &quot;Diabetes&quot;     THEN [pct_diabetes]&#13;&#10;  WHEN &quot;Hypertension&quot; THEN [pct_hypertension]&#13;&#10;  WHEN &quot;COPD&quot;         THEN [pct_copd]&#13;&#10;  WHEN &quot;Obesity&quot;      THEN [pct_obesity]&#13;&#10;  WHEN &quot;Depression&quot;   THEN [pct_depression]&#13;&#10;  WHEN &quot;Asthma&quot;       THEN [pct_asthma]&#13;&#10;  WHEN &quot;Stroke&quot;       THEN [pct_stroke]&#13;&#10;END' />
      </column>
      <column caption=' National Avg Prevalence' datatype='real' name='[Calculation_659214405123035137]' role='measure' type='quantitative'>
