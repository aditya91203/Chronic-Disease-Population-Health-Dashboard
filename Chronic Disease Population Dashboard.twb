            <column-instance column='[Calculation_659214405221449740]' derivation='None' name='[none:Calculation_659214405221449740:nk]' pivot='key' type='nominal' />
            <column-instance column='[geo_level]' derivation='None' name='[none:geo_level:nk]' pivot='key' type='nominal' />
            <column-instance column='[geo_name]' derivation='None' name='[none:geo_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_659214405221548045]' derivation='User' name='[usr:Calculation_659214405221548045:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
